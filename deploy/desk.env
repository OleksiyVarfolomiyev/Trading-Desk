# Settings for the desk on the server: read by the systemd services and by the desk user's shell
# (install_desk.sh adds it to ~/.profile), so commands run over SSH behave like the services.
# No TWS here: IB's equity, risk and positions come from the Mac's last push to the relay.
DESK_IB_SOURCE=relay
DESK_RELAY_URL=http://127.0.0.1:8787
# The HL API-wallet key and the relay token: a file only the desk user can read (no Keychain on Linux).
PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring
PYTHONUNBUFFERED=1
